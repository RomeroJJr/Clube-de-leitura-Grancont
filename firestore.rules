rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rjuniiior40@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'email']) 
        && (data.keys().size() == 2 || (data.keys().size() == 3 && 'department' in data))
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!('department' in data) || (data.department is string && data.department.size() <= 100));
    }

    match /employees/{empId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(empId) && isValidEmployee(incoming());
      allow update: if isAdmin() && isValidId(empId) && isValidEmployee(incoming());
      allow delete: if isAdmin() && isValidId(empId);
    }

    function isValidBook(data) {
      return data.keys().hasAll(['title', 'copies'])
        && (data.keys().size() == 2 
            || (data.keys().size() == 3 && ('author' in data || 'category' in data))
            || (data.keys().size() == 4 && 'author' in data && 'category' in data))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.copies is number
        && (!('author' in data) || (data.author is string && data.author.size() <= 200))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    match /books/{bookId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(bookId) && isValidBook(incoming());
      allow update: if isAdmin() && isValidId(bookId) && isValidBook(incoming());
      allow delete: if isAdmin() && isValidId(bookId);
    }

    function isValidLoan(data) {
      return data.keys().hasAll(['employeeId', 'bookId', 'checkoutDate', 'expectedReturnDate'])
        && data.keys().size() >= 4 && data.keys().size() <= 8
        && data.employeeId is string && data.employeeId.size() <= 128
        && data.bookId is string && data.bookId.size() <= 128
        && data.checkoutDate is string && data.checkoutDate.size() <= 50
        && data.expectedReturnDate is string && data.expectedReturnDate.size() <= 50
        && (!('actualReturnDate' in data) || (data.actualReturnDate is string && data.actualReturnDate.size() <= 50))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('renewals' in data) || (data.renewals is number))
        && (!('feedback' in data) || (data.feedback is string && data.feedback.size() <= 1000));
    }

    match /loans/{loanId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(loanId) && isValidLoan(incoming());
      allow update: if isAdmin() && isValidId(loanId) && isValidLoan(incoming());
      allow delete: if isAdmin() && isValidId(loanId);
    }

    function isValidSuggestion(data) {
      return data.keys().hasAll(['title', 'suggesterId', 'voters', 'status'])
        && (data.keys().size() == 4 || (data.keys().size() == 5 && 'author' in data))
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.suggesterId is string && data.suggesterId.size() <= 128
        && data.voters is list && data.voters.size() <= 1000
        && (data.voters.size() == 0 || data.voters[0] is string)
        && data.status in ['pending', 'purchased']
        && (!('author' in data) || (data.author is string && data.author.size() <= 200));
    }

    match /suggestions/{sugId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(sugId) && isValidSuggestion(incoming()) && incoming().status == 'pending';
      allow update: if isSignedIn() && isValidId(sugId) && isValidSuggestion(incoming()) && (
        isAdmin() ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['voters']))
      );
      allow delete: if isAdmin() && isValidId(sugId);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
